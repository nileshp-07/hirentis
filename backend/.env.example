ENV=development

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/hirentis
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
CLERK_SECRET_KEY=
# Frontend API URL of the Clerk instance (Clerk dashboard > API keys)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CORS_ORIGINS=http://localhost:3000

POSTGRES_PASSWORD=

# --- Optional ---
CLERK_WEBHOOK_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OPENAI_MODEL=gpt-4o-mini
# Which model does which job. gpt-4o-mini is cheap but gives a stiffer interviewer
# and less careful scoring; gpt-4.1 sounds much more natural and scores more
# accurately (roughly 10x the cost, about $0.15 per interview). The interviewer and
# the scorer matter most; the others default to OPENAI_MODEL.
# LLM_MODEL_INTERVIEWER=gpt-4.1
# LLM_MODEL_EVALUATOR=gpt-4.1
# LLM_MODEL_PLANNER=gpt-4.1
# LLM_MODEL_REPORTER=gpt-4.1
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
