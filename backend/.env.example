ENV=development

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/hirentis
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
CLERK_SECRET_KEY=
# Frontend API URL of the Clerk instance (Clerk dashboard > API keys)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CORS_ORIGINS=http://localhost:3000

POSTGRES_PASSWORD=

# --- Optional ---
CLERK_WEBHOOK_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
